# Local SQL Server container password. Placeholder only; replace for local use.
MSSQL_SA_PASSWORD=HospitalCare_Demo_ChangeMe_2026!
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=HospitalCare

# JWT validation and signing. Use a private random secret of at least 32 UTF-8 bytes.
JWT_SECRET=THIS_IS_A_DUMMY_LOCAL_JWT_SECRET_AT_LEAST_32_BYTES_CHANGE_ME
JWT_ISSUER=HospitalCare.Local
JWT_AUDIENCE=HospitalCare.Local.Client
JWT_EXPIRATION_MINUTES=30

# Optional development Admin seed account. Leave both empty to skip Admin seeding.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=Dummy_Admin_Password_ChangeMe_2026!

# Fake is local/demo mode. Its HMAC secret must be at least 32 UTF-8 bytes.
PAYMENT_GATEWAY_PROVIDER=Fake
FAKE_PAYMENT_WEBHOOK_SECRET=THIS_IS_A_DUMMY_FAKE_WEBHOOK_SECRET_AT_LEAST_32_BYTES_CHANGE_ME
FAKE_PAYMENT_CHECKOUT_BASE_URL=https://fake-payment.invalid/checkout/

# Paymob values are placeholders and are only needed when PAYMENT_GATEWAY_PROVIDER=Paymob.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=replace-with-your-paymob-secret-key
PAYMOB_PUBLIC_KEY=replace-with-your-paymob-public-key
PAYMOB_HMAC_SECRET=replace-with-your-paymob-hmac-secret
PAYMOB_INTEGRATION_ID=0
PAYMOB_CURRENCY=EGP
PAYMOB_NOTIFICATION_URL=https://example.test/api/payments/paymob/webhook
PAYMOB_REDIRECT_URL=

# Optional app settings; Africa/Cairo and the Serilog path are the application defaults.
HOSPITAL_TIME_ZONE_ID=Africa/Cairo
SERILOG_FILE_PATH=logs/hospitalcare-.log