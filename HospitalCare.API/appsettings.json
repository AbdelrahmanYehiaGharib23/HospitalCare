{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Hospital": {
    "TimeZoneId": "Africa/Cairo"
  },

  "PaymentGateway": {
    "Provider": "Fake"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=HospitalCareDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "HospitalCare.API",
    "Audience": "HospitalCare.Client",
    "ExpirationMinutes": 30
  }
}
